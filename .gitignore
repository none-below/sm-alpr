docs/data/articles_data.json
docs/data/dashboard.json
docs/data/audit_check_manifest.json
docs/js/map.js
assets/transparency.flocksafety.com/.sharing_graph_full.json
assets/**/_pending/
# Parser output for PRA-produced Flock audit PDFs. PRA folders stay bitwise
# vendor copies; audit_rows.json is regenerated by scripts/parse_pra_audit.py.
assets/san-mateo-public-records/*/audit_rows.json
# Build artifact, regenerated by scripts/build_pra_registry.py.
docs/data/pra_registry.json
# Build artifact, regenerated by scripts/build_pra_productivity.py.
docs/data/pra_productivity.json
# Match provenance (tiers/candidates/distances), regenerated by
# scripts/match_ori.py. Not read by any build — the durable output is the
# registry `ori` field. ~2 MB, would churn monthly via the FBI refresh action.
data/fbi/ori_matches.json
# LLM-verified backfill intermediates: candidate shortlists + per-batch splits
# (scripts/ori_backfill_candidates.py), and the decision/provenance dumps from
# the verification workflow. Durable output is the registry `ori` field.
data/fbi/ori_backfill_candidates.json
data/fbi/ori_backfill_compact.json
data/fbi/ori_backfill.json
data/fbi/ori_decisions.json
data/fbi/ori_batches/
# Legacy single-file article registry — replaced by per-article shards under
# assets/article_registry/ (see scripts/article_store.py). Gitignored so a
# stale copy or old script can't re-add it.
assets/article_registry.json
# Redwood City PD ALPR network-audit releases (PRA 26-217 + 26-741). The raw
# ~700MB of xlsx are kept local (too large for git); the parsed, per-release
# NDJSON under json/ IS committed (public record). The derived justifications
# source (RWC's own searches) is committed separately at
# assets/transparency.flocksafety.com/redwood-city-ca-pd/pra-26-217.json,
# regenerated by scripts/xlsx_to_audit_rows.py.
assets/redwood-city-pras/*
!assets/redwood-city-pras/json/
# Los Altos PD ALPR audit releases (PRA 26-366). Same split: the raw ~245MB of
# xlsx stay local, the parsed per-month NDJSON under json/ IS committed, as is
# the small shared-networks CSV the city produced alongside them.
assets/los-altos-pras/*
!assets/los-altos-pras/json/
!assets/los-altos-pras/SharedNetworks_2026_July_6.csv
