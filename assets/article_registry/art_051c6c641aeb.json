  "primary_subject_agency_ids": [],
  "summary": "The Denver Gazette surveys how Colorado governments are responding to controversy over Flock ALPR cameras, with some jurisdictions (Fort Collins, Steamboat Springs, Moffat County) canceling contracts and others (Denver, Douglas County, Longmont, Durango) switching to Axon. It contrasts Englewood's decision to end its Flock contract while rejecting an Axon replacement with Commerce City's approval of a $4.5M Flock contract, and reviews policy debates, misuse examples, and legal frameworks.",
  "key_quotes": [
    {
      "quote": "Fort Collins, Steamboat Springs and Moffat County have all dropped their Flock contracts and ordered the removal of the cameras from public streets. Others, including Denver, Douglas County , Longmont and Durango, have replaced Flock with Axon",
      "paragraph_idx": 18
    },
    {
      "quote": "In Englewood, the City Council voted Sept. 8 to end its contract with Flock. A vote to approve a contract with Axon narrowly failed on a 3-3 tie.",
      "paragraph_idx": 21
    },
    {
      "quote": "The City Council did not renew its Flock contract this year over reports that Denver's tracking data was on a national network available to immigration enforcement.",
      "paragraph_idx": 24
    },
    {
      "quote": "In April, Commerce City approved a $4.5 million contract with Flock for five years.",
      "paragraph_idx": 27
    }
  ],
