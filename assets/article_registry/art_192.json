  "primary_subject_agency_ids": [],
  "summary": "Gig Harbor, WA city council is set to vote on a contract with Flock Safety to install 10 automated license plate readers at city entry/exit points, with a $33,000 state grant covering year one. Council members raised privacy concerns about potential federal or third-party access and risks to domestic violence survivors, while the police chief emphasized retention limits and access controls.",
  "key_quotes": [
    {
      "quote": "the city will join other Pierce County jurisdictions including Bonney Lake, Eatonville, Lakewood, Puyallup and Sumner in using automated license plate readers",
      "paragraph_idx": 4
    },
    {
      "quote": "the city would only release the data to another police agency \"if they can show a valid violation of Washington state law.\" If a federal agency wanted to access the data, the city \"would only comply with a court order signed by a federal judge.\"",
      "paragraph_idx": 19
    },
    {
      "quote": "Flock encrypts and stores the data temporarily on a secure cloud server through Amazon Web Services for a default retention period of 30 days",
      "paragraph_idx": 10
    }
