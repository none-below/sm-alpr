  "primary_subject_agency_ids": [],
  "summary": "404 Media is crowdsourcing public records requests to obtain Axon ALPR activity, sharing, and hotlist audit reports from police agencies nationwide, as cities increasingly switch from Flock to Axon cameras. The article provides a template PRA request and notes 404 Media has already obtained activity reports from six agencies including Benton County SO (WA), Falmouth PD (ME), Johns Creek PD (GA), and others.",
  "key_quotes": [
    {
      "quote": "Cities around the country are ditching Flock's automatic license plate reader (ALPR) cameras, and replacing them with equivalent cameras from law enforcement contracting giant Axon.",
      "paragraph_idx": 6
    },
    {
      "quote": "So far, 404 Media has obtained activity reports from the Benton County Sheriff's Office, WA; Falmouth Police Department, ME; Johns Creek Police Department, GA; Ocean Shores Police Department, WA; Pleasanton Police Department, TX; and Red Wing Police Department, MN.",
      "paragraph_idx": 11
    }
