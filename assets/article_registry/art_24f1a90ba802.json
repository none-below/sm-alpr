  "primary_subject_agency_ids": [],
  "summary": "Keystone Local Schools and the Village of LaGrange, Ohio are partnering to install Flock Safety license plate reader cameras at school campuses and other locations, with the school board unanimously approving the contract on June 9. Officials cited investigative and safety benefits and pledged privacy safeguards, though community reaction on Facebook was largely opposed.",
  "key_quotes": [
    {
      "quote": "The school district's contract with Flock Safety for equipment and professional services passed unanimously at Keystone Board of Education's June 9 meeting.",
      "paragraph_idx": 8
    },
    {
      "quote": "comments on the school district's announcement post on Facebook were largely against incorporating the cameras on school property, with dozens of people voicing their strong opposition due to financial and privacy concerns.",
      "paragraph_idx": 10
    }
  ],
