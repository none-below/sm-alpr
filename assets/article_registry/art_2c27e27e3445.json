  "primary_subject_agency_ids": [],
  "summary": "Flock Safety hosted a private webinar coaching Bay Area police officers on how to pitch ALPR cameras to city councils, drawing criticism from privacy advocates who call it vendor lobbying disguised as training. The article notes the timing coincides with Bay Area pushback, including Berkeley rejecting an expansion and Richmond shutting down its ALPR network.",
  "key_quotes": [
    {
      "quote": "Flock Safety quietly hosted a private online training session that walked Bay Area officers through how to sell its license-plate readers and related surveillance tech to city councils, a move privacy advocates say looks a lot like vendor lobbying dressed up as training.",
      "paragraph_idx": 4
    },
    {
      "quote": "Flock's own event listing says the webinar covers how to \"make a case for ALPR to your city council\" and offers fundraising and media strategies to promote camera programs.",
      "paragraph_idx": 7
    },
    {
      "quote": "KQED notes that the state attorney general has brought cases where local ALPR data ended up accessible to federal agencies",
      "paragraph_idx": 12
    }
  ],
