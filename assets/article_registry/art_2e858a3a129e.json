  "primary_subject_agency_ids": [],
  "summary": "Sen. Ron Wyden endorsed a planned 2027 Oregon bill from state lawmakers Willy Chotzen and Alek Skarlatos to ban Flock and similar ALPR cameras statewide, calling them a 'weapon of mass inspection.' The article situates the push amid a wave of Oregon city cancellations (Eugene, Bend, Woodburn and others), ICE/federal access concerns, and parallel state-level restrictions elsewhere.",
  "key_quotes": [
    {
      "quote": "U.S. Sen. Ron Wyden stood near Clackamas Town Center and called a Flock camera a weapon of mass inspection, throwing his support behind a statewide effort to outlaw the automated license-plate readers across Oregon.",
      "paragraph_idx": 5
    },
    {
      "quote": "an audit confirmed that federal agencies tapped into Woodburn's camera network, with Homeland Security Investigations conducting 175 searches between March and May 2025 and U.S. Border Patrol logging 209 more between May and June of that year",
      "paragraph_idx": 10
    },
    {
      "quote": "At least six Oregon cities and two counties have now canceled or curtailed Flock contracts over privacy and data-leak worries",
      "paragraph_idx": 11
    },
    {
      "quote": "State legislatures in Washington, Kentucky and Oregon all enacted statewide restrictions on the technology in 2026",
      "paragraph_idx": 12
    }
  ],
