  "primary_subject_agency_ids": [],
  "summary": "Golden, Colorado's City Council is holding a study session to consider terminating its contract with Flock Safety and establishing a citywide framework for surveillance technology. The city has used 11 Flock cameras since 2023 under a contract running through July 2028, and the proposal by councilmembers Knecht and Kurzinski cites privacy and civil liberties concerns. Police Chief Michele Wagner defended the program, noting recent policy amendments including audits, limited data sharing, and 30-day retention.",
  "key_quotes": [
    {
      "quote": "The city of Golden is currently exploring how to exit its contract with the license plate reader company Flock and establish a framework for surveillance technology within the city.",
      "paragraph_idx": 6
    },
    {
      "quote": "Golden PD has created amendments to its policy on Flock cameras, which implemented an audit process, limited the sharing of Flock data from Golden and limited data retention to 30 days.",
      "paragraph_idx": 12
    },
    {
      "quote": "The data scale, searchability, sharing, and analytical capabilities of modern surveillance networks create privacy and civil liberties concerns that violate the constitutional rights for our community",
      "paragraph_idx": 16
    }
  ],
