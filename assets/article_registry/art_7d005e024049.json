  "primary_subject_agency_ids": [],
  "summary": "A former Flock Safety major accounts manager, Megan Deterling, filed a federal lawsuit in Austin alleging a sexist 'boys club' culture, discriminatory treatment, and retaliatory firing after she complained internally. The article situates the suit amid broader Flock troubles, including workforce cuts and dozens of Texas cities\u2014including Austin, Bandera, Bastrop, Leander, Pflugerville, and Dallas\u2014terminating or scaling back Flock contracts.",
  "key_quotes": [
    {
      "quote": "A former account manager at Flock Safety sued the surveillance technology company in federal court in Austin on Monday, alleging she was scrutinized more harshly than her male colleagues, pushed into an unfair travel assignment, and ultimately fired after she complained.",
      "paragraph_idx": 8
    },
    {
      "quote": "The Houston Chronicle found that two dozen Texas cities and counties have taken steps to remove Flock's automated license plate readers or end their contracts with the company.",
      "paragraph_idx": 19
    },
    {
      "quote": "Austin's own police department discontinued its automated license plate reader policy in July 2025 after ending its Flock pilot program, saying it had no plans to negotiate a new contract.",
      "paragraph_idx": 19
    }
  ],
