  "primary_subject_agency_ids": [],
  "summary": "EFF and the ACLU filed an amicus brief in the Sixth Circuit in United States v. Sturdivant, arguing that warrantless police searches of ALPR databases (Flock and ELSAG) used to track a robbery suspect's car near Cleveland constitute a Fourth Amendment search requiring a warrant. The brief urges reversal of a district court ruling that found no reasonable expectation of privacy in license plates observable in public.",
  "key_quotes": [
    {
      "quote": "ALPRs give law enforcement \"a virtual time machine to view suspects', or anyone else's, past movements (and much more) with just the click of a button.\"",
      "paragraph_idx": 7
    },
    {
      "quote": "a federal district court agreed and held that ALPRs are a \"form of indiscriminate mass surveillance\" that can violate the Fourth Amendment.",
      "paragraph_idx": 7
    }
  ],
