  "primary_subject_agency_ids": [],
  "summary": "EFF lays out a detailed state legislative agenda to end or restrict police use of ALPRs, advocating outright statewide bans, and failing that, strict limits on hotlists, retention, search, disclosure, transparency requirements, and enforcement mechanisms including private rights of action and the exclusionary rule. The piece cites recent 2026 state laws and references EFF lawsuits against San Jose and Wisconsin agencies (Milwaukee, Racine, Kenosha, Green Bay).",
  "key_quotes": [
    {
      "quote": "state lawmakers should pursue a complete, statewide ban on ALPR mass surveillance",
      "paragraph_idx": 16
    },
    {
      "quote": "In 2026 alone, six states enacted laws that limit police use of ALPRs: Connecticut, Kentucky, New Jersey, New Mexico, Oregon and Washington.",
      "paragraph_idx": 6
    },
    {
      "quote": "EFF has filed lawsuits making this demand in California and Wisconsin, along with local ACLU affiliates: SIREN and CAIR-CA v. San Jose, and Wisconsin Council of Churches v. Milwaukee, Racine, Kenosha, and Green Bay.",
      "paragraph_idx": 34
    }
  ],
