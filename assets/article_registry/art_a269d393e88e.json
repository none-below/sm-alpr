  "primary_subject_agency_ids": [],
  "summary": "Major retailers including Home Depot, Lowe's, Costco, Target and Walmart defend their use of ALPRs at store locations as responsible and security-focused, while privacy advocates and community groups warn that commercial ALPR deployments lack oversight and could feed data to ICE and other agencies. Shareholders of Home Depot and Lowe's recently rejected proposals to require new privacy risk reports on ALPR data sharing.",
  "key_quotes": [
    {
      "quote": "We are concerned that our company's license plate reader data could be used for controversial immigration enforcement purposes",
      "paragraph_idx": 9
    },
    {
      "quote": "We do not grant access to our license plate readers to federal law enforcement and we have not authorized any law enforcement agency other than local and state law enforcement agencies to access our ALPR data",
      "paragraph_idx": 13
    },
    {
      "quote": "local and state laws are \"desperately needed\" to regulate ALPRs",
      "paragraph_idx": 24
    }
