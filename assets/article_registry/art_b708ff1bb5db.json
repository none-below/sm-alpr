  "primary_subject_agency_ids": [],
  "summary": "Eudora, Kansas Police Chief Wes Lovett is seeking approval for an ~$18,000 ALPR at the city's only stoplight, having explicitly excluded Flock Safety from consideration citing backlash seen in nearby Gardner and Wellsville. The city commission has not yet approved the purchase, which would be funded via the general fund alongside a November sales tax measure for public safety.",
  "key_quotes": [
    {
      "quote": "Eudora Police Chief Wes Lovett wants an automated license plate reader posted at the city's only stoplight, but he has already crossed one major vendor off the list entirely: Flock Safety.",
      "paragraph_idx": 1
    },
    {
      "quote": "Lovett told KSHB 41 Kansas City that the department is researching an ALPR system with short-term data storage and limited data access, and that Flock-branded cameras have been eliminated from consideration.",
      "paragraph_idx": 2
    }
  ],
