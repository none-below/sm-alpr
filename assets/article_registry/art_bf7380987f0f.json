  "primary_subject_agency_ids": [],
  "summary": "Connecticut Democratic legislative leaders sent a letter to the CEOs of Home Depot and Lowe's pressing them to disclose how they collect, store and share ALPR data from their store parking lot cameras. The inquiry follows Gov. Ned Lamont's signing of SB 397, which regulates state and local ALPR use but does not cover private retailers.",
  "key_quotes": [
    {
      "quote": "ALPRs, while a useful tool for security and theft prevention, have the potential to be misused to track Connecticut residents, raising concerns not only about privacy in general, but also concerns about bad actors using ALPR data to enable stalking and harassment.",
      "paragraph_idx": 8
    },
    {
      "quote": "We do not grant access to our license plate readers to federal law enforcement.",
      "paragraph_idx": 10
    }
  ],
