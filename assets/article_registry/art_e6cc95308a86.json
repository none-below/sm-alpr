  "primary_subject_agency_ids": [],
  "summary": "404 Media reports that the federal HIDTA program, under the White House's ONDCP, is aggregating local ALPR data from Flock, Axon and other vendors into regional and national databases accessible to federal agencies including the DEA's National License Plate Reader Program. Georgia requires cities operating ALPRs on state rights-of-way to sign MOUs funneling data to HIDTA, and agencies have argued HIDTA records are shielded from FOIA.",
  "key_quotes": [
    {
      "quote": "The Trump administration is using an anti-drug trafficking grant program from the 1980s to force cities around the country to funnel their ongoing collection of automated license plate reader data into large federal surveillance centers that fall under the White House's jurisdiction",
      "paragraph_idx": 6
    },
    {
      "quote": "cities in Georgia are not allowed to operate ALPR systems on state rights of way without signing a \"memorandum of understanding\" (MOU) in which they promise to send their data to a HIDTA",
      "paragraph_idx": 14
    },
    {
      "quote": "all data is kept on the Federal Houston-HIDTA database",
      "paragraph_idx": 23
    },
    {
      "quote": "LPR reads from GDOT ROW cameras will be accessible to Georgia users of the HIDTA National LPR system through the Flock interface",
      "paragraph_idx": 17
    }
  ],
