  "primary_subject_agency_ids": [],
  "summary": "Following Missouri Gov. Mike Kehoe's Executive Order 26-18, the Missouri Department of Public Safety published statewide guidance for law enforcement on best practices for using automated license plate readers, including Flock Safety cameras. The guidance recommends purpose limitations, individual accountability, independent verification of alerts, a 30-day retention cap, monthly audits, and a prohibition on integrating facial recognition with ALPR.",
  "key_quotes": [
    {
      "quote": "Executive Order 26-18, signed on Sep. 18, was an order that looked to protect the safety and security of Missourians and target technology like ALPR and Flock Cameras.",
      "paragraph_idx": 6
    },
    {
      "quote": "limited (30 days in most cases) retention of ALPR data; routine auditing (at least monthly) and targeted reviews of ALPR use; and prohibiting the integration of artificial intelligence facial recognition technology with ALPR systems",
      "paragraph_idx": 10
    }
  ],
