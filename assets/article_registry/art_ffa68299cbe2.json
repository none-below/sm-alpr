  "primary_subject_agency_ids": [],
  "summary": "Vigilant Solutions was publicly recognized at the IACP Conference by the Long Beach Police Department for assisting in the investigation of the kidnapping and murder of three-week-old Eliza DeLaCruz. Detectives used Vigilant's national commercial LPR database to extend their search beyond Long Beach across multiple Southern California counties.",
  "key_quotes": [
    {
      "quote": "Homicide detectives learned that Vigilant Solutions maintains a national, commercial LPR database that is made available for law enforcement use.",
      "paragraph_idx": 10
    },
    {
      "quote": "the Long Beach PD's LPR data is limited to vehicles in the City of Long Beach, and the homicide investigation extended into Los Angeles, Orange, Riverside, and San Diego counties.",
      "paragraph_idx": 9
    }
  ],
