bledForUnapprovedCases":false,"arrestAgeOut":30,"inmatesEnabled":false,"inmatesPhotosEnabled":false,"inmatesShowName":true,"inmatesShowDateOfBirth":false,"inmatesShowAge":true,"inmatesShowSex":true,"inmatesShowRace":true,"inmatesShowHeight":true,"inmatesShowWeight":true,"inmatesShowHairColor":true,"inmatesShowEyeColor":true,"inmatesShowBuild":true,"inmatesShowComplexion":true,"inmatesShowInmateRealAddress":false,"inmatesRequireBookingComplete":false,"inmatesRequireBookingWithArrestLocation":false,"inmatesRequireBookingWithArrestAgency":false,"inmatesConvertToReleaseAgeOut":false,"crimeStatsEnabled":true,"pressReleaseEnabled":false,"dailyCrimeFireLogEnabled":false,"dailyCrimeFireLogMenuLabel":"Daily Crime/Fire Log Bulletin","dailyCrimeFireLogDaysIncluded":60,"dailyCrimeFireLogDaysDelay":2,"dailyCrimeFireLogShowNoRecord":true,"vacationCheckEnabled":false,"vacationCheckPreferredTimes":true,"vacationCheckRequestedChecksPerDay":true,"directedPatrolEnabled":false,"directedPatrolPreferredTimes":true,"directedPatrolRequestedChecksPerDay":true,"securityCameraEnabled":false,"agencySiteName":"Pacifica Police Department","enableMapFeatures":true,"showPlace":false,"crimeStatsDisclaimer":"","crimeStatsChartType":"Bar","stopDataStatsEnabled":true,"stopDataStatsDisclaimer":"","stopDataStatsDefinitions":"<p><strong style=\"font-size: 2.2rem;\">Definitions </strong></p><ol><li><strong>Stops: </strong>A stop is any interaction between someone and a police officer, in which the officer detains the person or conducts a search — including pedestrian and vehicle stops.</li><li><strong>Location: </strong>Pacifica Police Officers patrol Pacifica, CA.</li><li><strong>Race or Ethnicity (Perceived): </strong>These race and ethnicity categories are defined by RIPA. The officer reports their perception of people they stop in these categories: <ul><li>White</li><li>Hispanic/Latino</li><li>Black/African American</li><li>Asian</li><li>Middle Eastern </li><li>South Asian </li><li>Pacific Islander</li></ul></li><li><strong>Circumstance of the Stop: </strong>Was the stop a result of a call for service? If no, then the stop is deemed &quot;Officer Initiated.&quot;</li><li><strong>Reason for Stop - Reasonable Suspicion: </strong>When the reason for a stop is categorized as “reasonable suspicion of a person involved in criminal activity,” then the officer also selects from several sub-categories: <ul><li>Actions indicative of casing </li><li>Carrying suspicious object</li><li>Indicative of engaging in violent crime </li><li>Matched suspect description </li><li>Officer witnessed (officer witnessed commission of a crime) </li><li>Other (other reasonable suspicion) </li><li>Witness identification (witness or victim identification of suspect at scene)</li></ul></li><li><strong>Reason for Stop - Traffic Violation: </strong>When the reason for a stop is categorized as &quot;traffic violation,&quot; then the officer also selects from these sub-categories: <ul><li>Moving Violation </li><li>Equipment Violation </li><li>Non-Moving Violation</li></ul></li><li><strong>Result of the Stop: </strong>Potential results of a stop include:<ul><li>Warning</li><li>No Action</li><li>Citation for Infraction </li><li>Psychiatric Hold </li><li>Noncriminal/Car Transport </li><li>In-Field Cite and Release </li><li>Field Interview Card Completed</li><li>Custodial Arrest without Warrant</li></ul></li></ol>","lastUpdate":"2025-05-05T10:54:50.687","citizenRimsUrlPrefix":"pacifica","aboutPageLabel":"About","forcePeriodicUpdate":false,"forceHelperTablesUpdate":false,"forceFieldHelpStateNcicUpload":true,"lastPeriodicUpdate":"2026-09-14T01:10:00.353","lastCrimeStatisticsUpdate":"2026-09-14T00:10:00.073","lastStopDataStatisticsUpdate":"2026-09-01T00:05:00.473","mapDefaultNumDays":14,"missingPersonsShowPhotos":true,"stolenVehiclesShowPhotos":false,"mostWantedShowPhotos":false,"stopDataStatsShowZeroCounts":false,"stopDataStatsOnlyShowPercentages":false,"primaryAgencyId":63,"agencyIcon":"1c1623d0-cf06-4